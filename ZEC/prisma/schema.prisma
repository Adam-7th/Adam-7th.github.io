generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Movie {
  id            String   @id @default(cuid())
  titleRu       String
  titleEn       String?
  descriptionRu String
  descriptionEn String?
  year          Int?
  durationMin   Int?
  country       String   @default("Russia")
  tags          String[]
  imagePath     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
